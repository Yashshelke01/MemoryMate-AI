# Copy to .env (never commit .env). Read from the backend/ working directory.

# --- Accounts and sessions ---
# Account/session/conversation database; memories remain in FalkorDB.
SQLITE_DB_PATH=./memorymate.sqlite3
SESSION_COOKIE_NAME=memorymate_session
SESSION_TTL_SECONDS=1209600
# Keep false for local HTTP development; set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false

# --- CORS: explicit origins only, '*' is rejected ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=memorymate
FALKORDB_SOCKET_TIMEOUT_SECONDS=5

# --- LLM (used by backend extraction and grounded-answer services) ---
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Optional API base URL override; leave empty for the provider's official API.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120

# --- Limits / timeouts ---
MAX_MESSAGE_CHARS=4000
MAX_FACTS_PER_MESSAGE=10
MAX_CONTEXT_MEMORIES=10
RECENT_TURNS_MAX=6
GRAPH_MAX_NODES=200
CHAT_TIMEOUT_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
HEALTH_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO
